# Core
NODE_ENV=development
PORT=3000
DATABASE_URL=******localhost:5432/erp?schema=public
JWT_ACCESS_SECRET=change-this-to-a-random-32-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MIN=120
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
OTP_DEV_ECHO=true

# Files
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Optional integrations
GATEWAY_WEBHOOK_SECRET=
EJAR_WEBHOOK_SECRET=
SMS_ENABLED=false
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=RAMZ

# Optional business metadata
DOC_SIGNER_NAME=
COMPANY_BANK=
COMPANY_IBAN=

# Optional app metadata
APP_VERSION=dev
DISABLE_SCHEDULER=false
MAINT_REQUIRE_AFTER_PHOTO=false
