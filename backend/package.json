{
  "name": "property-erp-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start": "node dist/main",
    "seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:demo": "ts-node prisma/seed-demo.ts",
    "db:reset": "prisma migrate reset --force && npm run seed:demo"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^5.1.0",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "multer": "^1.4.5-lts.1",
    "@nestjs/serve-static": "^4.0.2",
    "prisma": "^5.10.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/multer": "^1.4.11",
    "@nestjs/schematics": "^10.1.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    "@types/express": "^4.17.21"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testEnvironment": "node"
  }
}
